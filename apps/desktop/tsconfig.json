{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "types": ["node"],
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "paths": {
      // 两条都要写：paths 的精确键不会自动覆盖子路径导入
      "@anyframe/core": ["../../packages/core/src/index.ts"],
      "@anyframe/core/node": ["../../packages/core/src/node.ts"],
      "@anyframe/ui": ["../../packages/ui/src/app-entry.ts"],
      "@/*": ["./src/renderer/*"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "*.config.ts"],
  "exclude": ["dist", "release", "node_modules"]
}
