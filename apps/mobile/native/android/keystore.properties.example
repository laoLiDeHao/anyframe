# ─────────────────────────────────────────────────────────────
# Android 发布签名配置（示例）
# ─────────────────────────────────────────────────────────────
# 用法：
#   cp keystore.properties.example keystore.properties
#   然后填入真实值。keystore.properties 已在 .gitignore 里，
#   永远不要提交。
#
# CI 上不要落盘这个文件，直接注入环境变量：
#   ANYFRAME_ANDROID_STORE_FILE / _STORE_PASSWORD / _KEY_ALIAS / _KEY_PASSWORD
# app/build.gradle 的片段里做了「环境变量优先，文件兜底」的读取，
# 见 native/android/app.build.gradle.fragment。
#
# 生成 keystore：
#   keytool -genkeypair -v \
#     -keystore anyframe-release.jks \
#     -keyalg RSA -keysize 4096 \
#     -validity 10000 \
#     -alias anyframe \
#     -dname "CN=AnyFrame, OU=Dev, O=YourOrg, L=City, ST=State, C=CN"
#
# ⚠️ -validity 10000 天（约 27 年）。Google Play 要求上传密钥的
#    有效期覆盖到 2033 年之后，用默认的 90 天会在几年后无法更新应用。
# ⚠️ keystore 一旦丢失，这个包名下的应用就永远无法再更新，
#    只能换包名重新上架。务必备份到密码管理器 / 离线介质。
# ⚠️ 若启用了 Play App Signing（新应用默认启用），上传密钥丢了
#    还能在 Play Console 重置；但本地直装分发（APK）没有这层保护。

# 相对路径以 android/app/ 为基准；建议把 jks 放在仓库外的安全位置，
# 用绝对路径引用，避免误提交。
storeFile=/absolute/path/to/anyframe-release.jks
storePassword=CHANGE_ME
keyAlias=anyframe
keyPassword=CHANGE_ME
