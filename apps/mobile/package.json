{
  "name": "@anyframe/mobile",
  "version": "0.0.2",
  "private": true,
  "type": "module",
  "description": "Android / iOS 移动端（Capacitor 8）",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.node.json",
    "test": "vitest run --passWithNoTests",
    "test:node": "node --test scripts/node-host.smoke.mjs",

    "sync": "cap sync",
    "setup:native": "node scripts/setup-native.mjs",

    "open:android": "cap open android",
    "open:ios": "cap open ios",
    "run:android": "cap run android",
    "run:ios": "cap run ios",

    "dist:android": "pnpm build && node scripts/setup-native.mjs android && node scripts/build-android.mjs",
    "dist:ios": "pnpm build && cap sync ios && node scripts/build-ios.mjs",

    "doctor": "cap doctor"
  },
  "dependencies": {
    "@anyframe/core": "workspace:*",
    "@capacitor/android": "catalog:",
    "@capacitor/app": "catalog:",
    "@capacitor/core": "catalog:",
    "@capacitor/filesystem": "catalog:",
    "@capacitor/ios": "catalog:",
    "@capacitor/network": "catalog:",
    "@capacitor/preferences": "catalog:",
    "@capacitor/splash-screen": "catalog:",
    "@capacitor/status-bar": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@capacitor/cli": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
