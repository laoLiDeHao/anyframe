# ─────────────────────────────────────────────────────────────
# pnpm 行为
# ─────────────────────────────────────────────────────────────
auto-install-peers=true
strict-peer-dependencies=false
resolution-mode=highest
enable-pre-post-scripts=true

# Electron 主进程需要能 require 到原生模块，避免过度提升造成幻影依赖
node-linker=isolated
public-hoist-pattern[]=*types*
public-hoist-pattern[]=*eslint*

# ─────────────────────────────────────────────────────────────
# 二进制下载源
# ─────────────────────────────────────────────────────────────
# electron / electron-builder 会从 GitHub Releases 拉二进制，
# 国内网络常超时。若 CI 或本机下载失败，取消下面两行注释：
#
# electron_mirror=https://npmmirror.com/mirrors/electron/
# electron_builder_binaries_mirror=https://npmmirror.com/mirrors/electron-builder-binaries/
#
# Capacitor / Gradle 的 Android SDK 组件走 Google 源，国内可设：
# ANDROID_SDK_ROOT 指向已配好镜像的 SDK 目录（见 scripts/check-env.mjs）
