{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    // 故意**不**加 "types": ["node"]：这个包里的代码全部跑在浏览器 /
    // WebView / Electron renderer 里，一旦允许 node:* 导入，类型检查就再也
    // 拦不住「UI 里 require 了 fs」这种只在打包后才炸的错误。
    // vite.config.ts 需要 node 类型，所以单独放在 tsconfig.node.json。
    "types": [],
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "paths": {
      "@anyframe/core": ["../core/src/index.ts"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  // 端到端测试要在 Node 里起真实 RPC 服务，与上面「不给 node 类型」的原则冲突，
  // 所以把它排除在 tsc 之外，只交给 vitest 执行。
  // 它验证的是路径约定与落盘行为，不是类型。
  "exclude": ["dist", "node_modules", "src/**/*.integration.test.ts"]
}
